<Window x:Class="WpfApp.DragAndDrop.MVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:WpfApp.DragAndDrop.MVVM.Models"
        xmlns:viewModels="clr-namespace:WpfApp.DragAndDrop.MVVM.ViewModels"
        xmlns:bh="clr-namespace:WpfApp.DragAndDrop.MVVM.Behaviors"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Window.DataContext>
        <viewModels:MainWindowViewModel/>
    </Window.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <ListView x:Name="ListViewBasket"
                  Grid.Column="0"
                  ItemsSource="{Binding Basket}"
                  SelectedItem="{Binding SelectedBasketItem}"
                  SelectedIndex="{Binding SelectedBasketItemIndex}"
                  SelectionMode="Single"
                  bh:DropTargetBehavior.DropCommand="{Binding DropItemCommand}"
                  bh:DropTargetBehavior.TargetItemType="{x:Type models:BasketItem}"
                  bh:DropTargetBehavior.DroppedItemType="{x:Type models:GroceryItem}">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:BasketItem}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                        <TextBlock Text=" | " />
                        <TextBlock Text="{Binding Quantity}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ListView x:Name="ListViewGroceries"
                  Grid.Column="2"
                  ItemsSource="{Binding Groceries}"
                  SelectedItem="{Binding SelectedGroceryItem}"
                  SelectedIndex="{Binding SelectedGroceryItemIndex}"
                  SelectionMode="Single"
                  bh:DragSourceBehavior.IsEnabled="True"/>
    </Grid>
</Window>

<Window x:Class="WpfApp.DragAndDrop.MVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:WpfApp.DragAndDrop.MVVM.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel, IsDesignTimeCreatable=False}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <ListView x:Name="ListViewBasket"
                  Grid.Column="0"
                  ItemsSource="{Binding Basket}"
                  SelectedItem="{Binding SelectedBasketItem}"
                  SelectedIndex="{Binding SelectedBasketItemIndex}"
                  SelectionMode="Single"
                  AllowDrop="True"
                  Drop="ListViewBasket_OnDrop"/>

        <ListView x:Name="ListViewGroceries"
                  Grid.Column="2"
                  ItemsSource="{Binding Groceries}"
                  SelectedItem="{Binding SelectedGroceryItem}"
                  SelectedIndex="{Binding SelectedGroceryItemIndex}"
                  SelectionMode="Single"
                  MouseMove="ListViewGroceries_OnMouseMove"
                  PreviewMouseLeftButtonDown="ListViewGroceries_OnPreviewMouseLeftButtonDown"/>

    </Grid>
</Window>
